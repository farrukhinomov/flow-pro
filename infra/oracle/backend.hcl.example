# Copy to backend.hcl and fill in. backend.hcl is not tracked.
# Usage: tofu init -backend-config=backend.hcl
#
# Oracle Object Storage speaks the S3 protocol. Create the bucket and a
# "Customer Secret Key" in the console, then export the key pair as
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY before running tofu.
bucket = "flowpro-tofu-state"
key    = "oracle/terraform.tfstate"
region = "eu-frankfurt-1"

endpoints = {
  s3 = "https://<object storage namespace>.compat.objectstorage.eu-frankfurt-1.oraclecloud.com"
}

skip_region_validation      = true
skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = true
