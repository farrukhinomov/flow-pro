# Copy to .env to override the defaults used by compose.yaml.
# These values are local development defaults. A public deployment
# (compose.public.yaml) requires its own strong values for every secret.

# Port the app is served on locally: http://localhost:8088
FLOWPRO_HTTP_PORT=8088

FLOWPRO_POSTGRES_DB=flowpro
FLOWPRO_POSTGRES_USER=flowpro
FLOWPRO_POSTGRES_PASSWORD=superadmin
# The PostgreSQL administrator, used only for backups and restores.
FLOWPRO_POSTGRES_ADMIN_PASSWORD=postgres-admin

# Password of the seeded development accounts founder@flowpro.local and
# hannah.fischer@flowpro.test. Local stack only; never seeded in public mode.
FLOWPRO_DEV_ACCOUNT_PASSWORD=superadmin

# pgAdmin (--profile tools)
FLOWPRO_PGADMIN_EMAIL=admin@flowpro.local
FLOWPRO_PGADMIN_PASSWORD=superadmin

FLOWPRO_BACKUP_DIR=./backups
FLOWPRO_DATA_PROTECTION_CERTIFICATE_PATH=
FLOWPRO_DATA_PROTECTION_CERTIFICATE_PASSWORD=

# Public deployment only (compose.public.yaml)
# FLOWPRO_DOMAIN=flowpro.example.com
# Set to false to stop new people from creating accounts (invitation only).
# FLOWPRO_REGISTRATION_ENABLED=true

# Public demo (compose.public.yaml): shared one-click logins per role, and the
# whole database wiped and seeded again every night. Only for a server of its
# own; it needs FLOWPRO_REGISTRATION_ENABLED=false and no SMTP host, so the
# demo cannot send mail. The password is shown on the sign-in page.
# FLOWPRO_DEMO_MODE=false
# FLOWPRO_DEMO_PASSWORD=
# FLOWPRO_DEMO_RESET_AT_UTC=03:00
# FLOWPRO_VERSION=1.0.0
#
# Outgoing mail for email confirmation and password reset. Any SMTP server
# works; port 587 with STARTTLS is the usual choice (StartTls, SslOnConnect).
# FLOWPRO_EMAIL_FROM=no-reply@flowpro.example.com
# FLOWPRO_SMTP_HOST=smtp.example.com
# FLOWPRO_SMTP_PORT=587
# FLOWPRO_SMTP_USERNAME=
# FLOWPRO_SMTP_PASSWORD=
# FLOWPRO_SMTP_SECURITY=StartTls
#
# Per-address request budgets. Raise them when many people reach FlowPro from
# one public address, such as an office behind one NAT. They cannot be turned off.
# FLOWPRO_RATE_LIMIT_SIGN_IN_PER_MINUTE=10
# FLOWPRO_RATE_LIMIT_ACCOUNT_EMAIL_PER_15_MINUTES=5
# FLOWPRO_RATE_LIMIT_REGISTRATIONS_PER_HOUR=5
