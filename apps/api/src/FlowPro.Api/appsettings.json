{
  "AllowedHosts": "*",
  "Authentication": {
    "Mode": "Session"
  },
  "Attachments": {
    "MaxUploadBytes": 10485760,
    "SoftDeletedRetentionDays": 180,
    "AllowedContentTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "text/csv",
      "text/plain"
    ]
  },
  "AttachmentStorage": {
    "Provider": "Local",
    "LocalRootPath": "/var/lib/flowpro/attachments"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "DataProtection": {
    "ApplicationName": "FlowPro"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDevelopmentData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
