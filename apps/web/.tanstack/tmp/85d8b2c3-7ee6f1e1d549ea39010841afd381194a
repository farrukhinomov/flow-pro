// ─── Types ───────────────────────────────────────────────────────────────────

type AbsenceEntry = {
  date: string // ISO - absence start/next date
  code: string
  label: string
}

type Employee = {
  id: string
  name: string
  status: 'absent'
  absentUntil?: string // ISO date, empty = ongoing/unknown
  absences?: AbsenceEntry[]
}

// ─── Data (parsed from HTML) ─────────────────────────────────────────────────

const EMPLOYEES: Employee[] = [
  {
    id: '1',
    name: 'Stolz, Rebekka',
    status: 'absent',
    absentUntil: '2026-06-01',
  },
  { id: '2', name: 'Müller, Michael', status: 'absent' },
  {
    id: '3',
    name: 'Marx, Andreas',
    status: 'absent',
    absentUntil: '2026-05-31',
  },
  { id: '4', name: 'Klein, Dirk', status: 'absent' },
]

const TODAY = new Date()

function getUntilLabel(until?: string): { label: string; urgent: boolean } {
  if (!until) return { label: '—', urgent: false }
  try {
    const d = parseISO(until)
    const urgent = isBefore(
      d,
      new Date(TODAY.getFullYear(), TODAY.getMonth(), TODAY.getDate() + 3)
    )
    return {
      label: format(d, 'dd/MM/yyyy'),
      urgent,
    }
  } catch {
    return { label: until, urgent: false }
  }
}

