# Copy to .env.local for `npm run dev` against an API started from an IDE.
# The API's Development settings seed founder@flowpro.local and
# hannah.fischer@flowpro.test, both with the password "superadmin".
VITE_FLOWPRO_API_BASE_URL=http://localhost:5123/api/v1
VITE_FLOWPRO_AUTH_MODE=session

# UI work without any backend: in-browser simulation with demo users.
# VITE_FLOWPRO_AUTH_MODE=local
