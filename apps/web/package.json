{
  "name": "flow-pro",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/run-with-project-node.mjs vite",
    "build": "node scripts/run-with-project-node.mjs node scripts/check-node-version.mjs && node scripts/run-with-project-node.mjs tsc -b && node scripts/run-with-project-node.mjs vite build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:quick": "npm run lint && npm test",
    "check:runtime": "node scripts/run-with-project-node.mjs node scripts/check-node-version.mjs",
    "lint": "eslint .",
    "maintenance": "node scripts/maintenance-check.mjs",
    "generate:api-contracts": "node scripts/generate-api-contracts.mjs",
    "test": "node scripts/run-node-tests.mjs src",
    "test:domain": "node scripts/run-node-tests.mjs src/domain",
    "test:e2e": "bash scripts/run-integrated-e2e.sh --project=functional",
    "test:e2e:visual": "bash scripts/run-integrated-e2e.sh --project=visual",
    "test:e2e:session": "bash scripts/run-session-e2e.sh",
    "test:e2e:demo": "bash scripts/run-demo-e2e.sh",
    "test:e2e:ui": "env -u NO_COLOR playwright test",
    "test:public-runtime": "node scripts/smoke-public-runtime.mjs",
    "test:watch": "node scripts/run-node-tests.mjs --watch src",
    "typecheck": "tsc -b",
    "preview": "node scripts/run-with-project-node.mjs vite preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "knip": "knip --exclude exports,types",
    "licenses": "license-checker-rseidelsohn --excludePrivatePackages --summary --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;BlueOak-1.0.0;MPL-2.0;CC0-1.0;CC-BY-3.0;CC-BY-4.0;Unlicense;Python-2.0\""
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-top-loading-bar": "^3.0.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.48",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "license-checker-rseidelsohn": "4.4.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
